# Server
PORT=5001

# MongoDB connection string (Atlas or local)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret (use a long random string)

# Comma-separated list of allowed frontend origins for CORS
# (localhost origins are always allowed; add your deployed frontend here)
CLIENT_URL=http://localhost:5002

# Google OAuth - create an OAuth 2.0 Client ID (Web application):
# https://console.cloud.google.com/apis/credentials
# Its "Authorized redirect URI" must be {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Better Auth (secret must be 32+ chars; generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-32-char-minimum-secret
# Base URL Better Auth uses to build the Google callback: {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:5001

# Cross-site session cookies. On HTTPS they are auto-enabled
# (SameSite=None; Secure; Partitioned) because the frontend usually lives on a
# different site. Force with "true", disable with "false"; leave unset to auto.
CROSS_SITE_COOKIES=

# CHIPS Partitioned cookies are keyed to the top-level site at set time, so they
# are NOT sent when an OAuth redirect chain returns from a different top-level
# site (frontend -> accounts.google.com -> this callback), which fails the state
# check with ?error=state_mismatch. Set to "false" to drop Partitioned and use
# the classic SameSite=None; Secure cookie, which rides the whole chain.
# Defaults to "true"; only the OAuth deployments need "false".
PARTITIONED_COOKIES=
