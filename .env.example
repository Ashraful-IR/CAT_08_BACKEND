# Server
PORT=5001

# MongoDB connection string (Atlas or local)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed frontend origins for CORS
# (localhost origins are always allowed; add your deployed frontend here)
CLIENT_URL=http://localhost:5002
